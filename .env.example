# Copy this file to .env and fill in your values. Never commit .env.
# On Vercel, add the same names under Settings > Environment Variables.

# Which AI to use: auto (Gemini first, then Claude) | gemini | claude
AI_PROVIDER=auto

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Paid key (optional): https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Answer length (tokens) and creativity (0 = strict, 1 = creative)
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.4
