# Copy this file to .env and fill in your values. Never commit .env.
# On Vercel, add the same names under Settings > Environment Variables.

# Which AI to use: auto (Gemini first, then Claude) | gemini | claude
AI_PROVIDER=auto

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used automatically if the main model is busy or out of quota
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Paid key (optional): https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Answer length (tokens) and creativity (0 = strict, 1 = creative)
AI_MAX_TOKENS=700
AI_TEMPERATURE=0.4

# Gemini hidden reasoning tokens. 0 = off (recommended, keeps answers from being cut off)
AI_THINKING_BUDGET=0
